// ---------------------------------------------------------------- fichas
String fName(Int k) {
    if (k == 0) { return "RAFA RAIO" }
    if (k == 1) { return "BRUNO MURALHA" }
    if (k == 2) { return "KENJI CONTRA" }
    return "DANTE TRATOR"
}

String fStyle(Int k) {
    if (k == 0) { return "BOXEADOR - RAPIDO E TECNICO" }
    if (k == 1) { return "TANQUE - AGUENTA TUDO" }
    if (k == 2) { return "CONTRA-GOLPE - DEFESA" }
    return "PRESSAO - PANCADA PESADA"
}

// atributos 1..5: 0 forca, 1 velocidade, 2 queixo, 3 folego, 4 defesa
Int stat(Int k, Int a) {
    var t = "25244" + "31552" + "33335" + "53322"
    return digit(t, k * 5 + a)
}

Color skinC(Int k) {
    if (k == 0) { return Color(198, 140, 98) }
    if (k == 1) { return Color(236, 196, 160) }
    if (k == 2) { return Color(222, 178, 132) }
    return Color(112, 72, 46)
}

Color hairC(Int k) {
    if (k == 0) { return Color(28, 22, 18) }
    if (k == 1) { return Color(150, 72, 34) }
    if (k == 2) { return Color(18, 18, 24) }
    return Color(20, 14, 10)
}

Color trunkC(Int k) {
    if (k == 0) { return Color(245, 190, 40) }
    if (k == 1) { return Color(40, 170, 90) }
    if (k == 2) { return Color(235, 235, 240) }
    return Color(130, 60, 200)
}

Color trimC(Int k) {
    if (k == 0) { return Color(20, 20, 24) }
    if (k == 1) { return Color(240, 240, 240) }
    if (k == 2) { return Color(210, 30, 40) }
    return Color(250, 210, 60)
}

Color gloveC(Int k) {
    if (k == 0) { return Color(220, 30, 40) }
    if (k == 1) { return Color(30, 90, 210) }
    if (k == 2) { return Color(25, 25, 28) }
    return Color(240, 175, 20)
}

// ---------------------------------------------------------------- golpes
// tabela por golpe 1..5: preparo, ativo, recuperacao, dano, custo, alcance, atordoa, empurra
class PT {
    static List<Int> D = listOf<Int>()
}

buildPunchTable() {
    var t = listOf(5, 3, 9, 34, 22, 100, 12, 4,
        8, 3, 14, 62, 42, 112, 16, 7,
        10, 4, 17, 78, 55, 86, 20, 9,
        12, 4, 21, 92, 68, 74, 24, 10,
        9, 3, 16, 56, 46, 92, 18, 6)
    for (var v in t) { PT.D.add(v) }
}

Int pData(Int p, Int col) {
    if (p < 1 || p > 5) { return 0 }
    return PT.D.get((p - 1) * 8 + col)
}

Int pStart(Int p) { return pData(p, 0) }
Int pAct(Int p) { return pData(p, 1) }
Int pRec(Int p) { return pData(p, 2) }
Int pDmg(Int p) { return pData(p, 3) }
Int pCost(Int p) { return pData(p, 4) }
Int pReach(Int p) { return pData(p, 5) }
Int pStun(Int p) { return pData(p, 6) }
Int pPush(Int p) { return pData(p, 7) }

String pName(Int p) {
    if (p == K.JAB) { return "JAB" }
    if (p == K.CROSS) { return "DIRETO" }
    if (p == K.HOOK) { return "GANCHO" }
    if (p == K.UPPER) { return "UPPERCUT" }
    return "CORPO"
}

// ---------------------------------------------------------------- objetos
class Fighter {
    Int kind = 0
    Bool human = true
    Int side = 1
    Double x = 300.0
    Double z = 50.0
    Double vx = 0.0
    Double vz = 0.0
    Int face = 1
    Int st = 0
    Int stT = 0
    Int stLen = 0
    Int punch = 0
    Bool star = false
    Bool hitDone = false
    Int hp = 1000
    Int rec = 0
    Int lag = 1000
    Int lagT = 0
    Int sta = 1000
    Int bodyDmg = 0
    Int meter = 0
    Int hitCool = 0
    Int kd = 0
    Int kdTotal = 0
    Int combo = 0
    Int comboT = 0
    Int counterT = 0
    Int flash = 0
    Double walk = 0.0
    Double snap = 0.0
    Double lean = 0.0
    Int blinkT = 0
    // entrada
    Bool inL = false
    Bool inR = false
    Bool inU = false
    Bool inD = false
    Bool inG = false
    Bool inMod = false
    Int qPunch = 0
    Bool qSlip = false
    // estatisticas (luta e round)
    Int thrown = 0
    Int landed = 0
    Int power = 0
    Int thrownR = 0
    Int landedR = 0
    Int powerR = 0
    Int dmgR = 0
    Int kdR = 0
    // IA
    Int aiT = 0
    Int aiGuard = 0
    String plan = ""
    Int planI = 0
    Int[] seen = new Int[6]
    Int riseAt = 0
    // minijogo de levantar
    Int riseOk = 0
    Int riseCool = 0
    Int tiredT = -999
}

class Part {
    Double x = 0.0
    Double y = 0.0
    Double vx = 0.0
    Double vy = 0.0
    Int t = 0
    Int life = 30
    Int kind = 0
    Double r = 3.0
    Color col = Color(255, 255, 255)
}

class Pop {
    String s = ""
    Double x = 0.0
    Double y = 0.0
    Int t = 0
    Int life = 70
    Int sz = 5
    Color col = Color(255, 255, 255)
}

class Card {
    Int[] a = new Int[13]
    Int[] b = new Int[13]
    Int bias = 0
}

class Game {
    Int state = 0
    Int t = 0
    Int frame = 0
    Int round = 1
    Int rounds = 3
    Int roundLen = 3600
    Int clock = 3600
    Int mode = 1
    Int diff = 2
    Int sel1 = 0
    Int sel2 = 3
    Int cursor = 0
    Fighter a = Fighter()
    Fighter b = Fighter()
    Rng r = Rng()
    Mixer mix = Mixer()
    // camera e efeitos
    Double camX = 480.0
    Double camY = 330.0
    Double zoom = 1.0
    Double shake = 0.0
    Int hitstop = 0
    Int slow = 0
    Int flashScr = 0
    Double hype = 0.2
    List<Part> parts = listOf<Part>()
    List<Pop> pops = listOf<Pop>()
    // queda
    Int downWho = 0
    Int count = 0
    Int countT = 0
    Int riseT = 0
    // fim
    Int winner = 0
    String how = ""
    String sub = ""
    Card c1 = Card()
    Card c2 = Card()
    Card c3 = Card()
    Int prevState = 0
    Int heartT = 0
    Bool loaded = false
}

Fighter other(Game g, Fighter p) {
    if (p == g.a) { return g.b }
    return g.a
}

// ---------------------------------------------------------------- efeitos
pop(Game g, String s, Double x, Double y, Int sz, Color col) {
    // sem repeticao do mesmo texto e empilha os que aparecem juntos
    var yy = y
    for (var q in g.pops) {
        if (q.s == s && q.t < 50) { return }
        if (dabs(q.x - x) < 160.0 && dabs(q.y - yy) < toD(q.sz * 8)) { yy = q.y - toD(q.sz * 9) }
    }
    var p = Pop()
    p.s = s
    p.x = x
    p.y = yy
    p.sz = sz
    p.col = col
    g.pops.add(p)
}

burst(Game g, Double x, Double y, Int n, Int kind, Color col, Double spd) {
    for (var i = 0; i < n; i++) {
        var p = Part()
        var ang = rndd(g.r) * K.TAU
        var v = spd * (0.4 + rndd(g.r))
        p.x = x
        p.y = y
        p.vx = cs(ang) * v
        p.vy = sn(ang) * v - spd * 0.4
        p.kind = kind
        p.col = col
        p.life = 22 + rnd(g.r, 22)
        p.r = 1.5 + rndd(g.r) * 3.0
        g.parts.add(p)
    }
}

Double floorY(Double z) {
    return 330.0 + z * 1.35
}

Double scaleZ(Double z) {
    return 0.82 + z * 0.0026
}

Double headY(Fighter p) {
    return floorY(p.z) - 182.0 * scaleZ(p.z)
}

// ---------------------------------------------------------------- regras
resetFighter(Fighter p, Int kind, Bool human, Int side) {
    p.kind = kind
    p.human = human
    p.side = side
    p.hp = 1000
    p.rec = 0
    p.lag = 1000
    p.sta = 1000
    p.bodyDmg = 0
    p.meter = 0
    p.kd = 0
    p.kdTotal = 0
    p.thrown = 0
    p.landed = 0
    p.power = 0
    for (var i = 0; i < 6; i++) { p.seen[i] = 0 }
    toCorner(p)
}

toCorner(Fighter p) {
    p.st = K.IDLE
    p.stT = 0
    p.punch = 0
    p.vx = 0.0
    p.vz = 0.0
    p.z = 50.0
    p.combo = 0
    p.comboT = 0
    p.counterT = 0
    p.qPunch = 0
    p.qSlip = false
    p.plan = ""
    p.aiGuard = 0
    p.inG = false
    p.thrownR = 0
    p.landedR = 0
    p.powerR = 0
    p.dmgR = 0
    p.kdR = 0
    p.kd = 0
    if (p.side == 1) {
        p.x = 330.0
        p.face = 1
    } else {
        p.x = 630.0
        p.face = -1
    }
}

Int staMax(Fighter p) {
    return 1000 - p.bodyDmg / 2
}

startFight(Game g) {
    resetFighter(g.a, g.sel1, true, 1)
    resetFighter(g.b, g.sel2, g.mode == 2, 2)
    g.round = 1
    g.winner = 0
    g.how = ""
    g.sub = ""
    g.c1 = Card()
    g.c2 = Card()
    g.c3 = Card()
    g.c1.bias = rnd(g.r, 3) - 1
    g.c2.bias = rnd(g.r, 3) - 1
    g.c3.bias = rnd(g.r, 3) - 1
    g.mix.playCrowd = true
    g.mix.playMusic = false
    startRound(g)
}

startRound(Game g) {
    toCorner(g.a)
    toCorner(g.b)
    g.clock = g.roundLen
    g.state = K.INTRO
    g.t = 0
    g.parts = listOf<Part>()
    g.pops = listOf<Pop>()
    g.zoom = 1.25
}

startPunch(Game g, Fighter p, Int type) {
    var cost = pCost(type)
    if (p.sta < cost / 2) {
        if (p.human && g.frame - p.tiredT > 150) {
            p.tiredT = g.frame
            pop(g, "SEM FOLEGO", p.x, headY(p) - 30.0, 3, Color(150, 200, 255))
        }
        p.qPunch = 0
        return
    }
    p.star = false
    if (p.inMod && p.meter >= 100 && type != K.JAB) {
        p.star = true
        p.meter = 0
        sfx(g, K.S_STAR)
        pop(g, "SUPER GOLPE", p.x, headY(p) - 40.0, 4, Color(255, 220, 60))
    }
    p.st = K.PUNCH
    p.stT = 0
    p.punch = type
    p.hitDone = false
    p.stLen = pStart(type) + pAct(type) + pRec(type)
    if (p.star) { p.stLen = p.stLen + 6 }
    p.sta = imax(0, p.sta - cost)
    p.thrown = p.thrown + 1
    p.thrownR = p.thrownR + 1
    p.qPunch = 0
    var o = other(g, p)
    o.seen[type] = o.seen[type] + 1
}

Int startupOf(Fighter p) {
    if (p.star) { return pStart(p.punch) + 6 }
    return pStart(p.punch)
}

resolve(Game g, Fighter at, Fighter df) {
    var type = at.punch
    var dx = (df.x - at.x) * toD(at.face)
    var dz = dabs(df.z - at.z)
    var reach = toD(pReach(type)) + toD(stat(at.kind, 1)) * 2.0
    if (dx < 22.0 || dx > reach || dz > 18.0 || df.st == K.FALL || df.st == K.RISE) {
        sfx(g, K.S_WHOOSH)
        at.sta = imax(0, at.sta - 12)
        at.combo = 0
        return
    }
    var hx = df.x - toD(at.face) * 14.0
    var hy = headY(df) + 10.0
    if (type == K.BODY) { hy = floorY(df.z) - 120.0 * scaleZ(df.z) }
    // esquiva perfeita
    if (df.st == K.SLIP && df.stT >= 3 && df.stT <= 16) {
        sfx(g, K.S_SLIP)
        pop(g, "ESQUIVA PERFEITA", df.x, headY(df) - 34.0, 4, Color(110, 230, 255))
        g.slow = 42
        df.counterT = 55
        df.meter = imin(100, df.meter + 18)
        at.sta = imax(0, at.sta - 30)
        at.combo = 0
        return
    }
    var isBody = type == K.BODY
    var dmg = pDmg(type)
    dmg = dmg * (80 + stat(at.kind, 0) * 10) / 100
    dmg = dmg * (60 + at.sta * 40 / 1000) / 100
    dmg = dmg * (118 - stat(df.kind, 2) * 6) / 100
    // combo
    if (at.comboT > 0) { at.combo = at.combo + 1 } else { at.combo = 1 }
    at.comboT = 50
    var scale = 100
    if (at.combo == 3) { scale = 90 }
    if (at.combo == 4) { scale = 80 }
    if (at.combo >= 5) { scale = 70 }
    dmg = dmg * scale / 100
    // contra-ataque
    var counter = false
    if (df.st == K.PUNCH) {
        if (df.stT < startupOf(df)) { counter = true }
    }
    if (at.counterT > 0) {
        counter = true
        at.counterT = 0
    }
    if (counter) { dmg = dmg * 3 / 2 }
    if (at.star) { dmg = dmg * 22 / 10 }
    // guarda
    var guarding = df.inG && (df.st == K.IDLE || df.st == K.BLOCKED)
    if (guarding && !isBody && !at.star) {
        if (df.sta < 110) {
            pop(g, "GUARDA QUEBRADA", df.x, headY(df) - 34.0, 4, Color(255, 120, 60))
        } else {
            df.sta = imax(0, df.sta - pDmg(type) / 2)
            df.st = K.BLOCKED
            df.stT = 0
            df.stLen = 8 + type
            df.vx = df.vx + toD(at.face) * toD(pPush(type)) * 0.25
            df.hp = imax(1, df.hp - dmg * 12 / 100)
            at.meter = imin(100, at.meter + 2)
            at.combo = 0
            sfx(g, K.S_BLOCK)
            burst(g, hx, hy, 5, 1, Color(255, 255, 255), 2.5)
            g.hitstop = 3
            return
        }
    }
    if (guarding && isBody) { dmg = dmg * 75 / 100 }
    // aplica o dano
    df.hp = df.hp - dmg
    df.rec = imin(df.rec + dmg * 35 / 100, 1000 - imax(0, df.hp))
    df.hitCool = 100
    df.lagT = 30
    if (isBody) {
        df.bodyDmg = imin(800, df.bodyDmg + dmg / 2)
        df.sta = imax(0, df.sta - dmg / 2)
    }
    df.st = K.HIT
    df.stT = 0
    // decaimento: cada golpe seguido atordoa menos e empurra mais (sem combo infinito)
    var decay = imax(25, 100 - (at.combo - 1) * 20)
    df.stLen = imax(4, pStun(type) * decay / 100)
    if (at.star) { df.stLen = pStun(type) * 16 / 10 }
    df.vx = df.vx + toD(at.face) * toD(pPush(type)) * (0.4 + toD(imin(at.combo, 6)) * 0.12)
    df.snap = 1.0
    df.flash = 6
    df.qPunch = 0
    df.plan = ""
    df.combo = 0
    at.landed = at.landed + 1
    at.landedR = at.landedR + 1
    at.dmgR = at.dmgR + dmg
    if (type != K.JAB) {
        at.power = at.power + 1
        at.powerR = at.powerR + 1
    }
    at.meter = imin(100, at.meter + dmg / 6 + 1)
    if (at.meter >= 100 && at.human) { pop(g, "ESPECIAL PRONTO (R)", at.x, headY(at) - 50.0, 3, Color(255, 220, 60)) }
    // sons e efeitos
    if (type == K.JAB) { sfx(g, K.S_JAB) }
    if (type == K.CROSS) { sfx(g, K.S_CROSS) }
    if (type == K.HOOK) { sfx(g, K.S_HOOK) }
    if (type == K.UPPER) { sfx(g, K.S_UPPER) }
    if (type == K.BODY) { sfx(g, K.S_BODY) }
    var power = toD(dmg) / 60.0
    g.hitstop = imin(14, 3 + dmg / 18)
    g.shake = clampd(power * 5.0, 1.0, 14.0)
    g.hype = clampd(g.hype + power * 0.08, 0.0, 1.0)
    burst(g, hx, hy, 6 + dmg / 10, 0, Color(190, 230, 255), 3.5 + power * 2.0)
    burst(g, hx, hy, 3 + dmg / 25, 1, Color(255, 240, 160), 4.0 + power * 2.0)
    if (counter) { pop(g, "CONTRA-ATAQUE", df.x, headY(df) - 40.0, 4, Color(255, 90, 80)) }
    if (at.combo >= 3) { pop(g, at.combo + " GOLPES", at.x, headY(at) - 60.0, 4, Color(255, 200, 70)) }
    if (at.star) {
        g.flashScr = 8
        g.slow = 30
        g.hitstop = 16
    }
    if (df.hp <= 0) { knockdown(g, at, df) }
}

knockdown(Game g, Fighter at, Fighter df) {
    df.hp = 0
    df.rec = 0
    df.st = K.FALL
    df.stT = 0
    df.kd = df.kd + 1
    df.kdR = df.kdR + 1
    df.kdTotal = df.kdTotal + 1
    df.riseOk = 0
    df.riseCool = 0
    df.inG = false
    at.st = K.IDLE
    at.stT = 0
    at.plan = ""
    g.state = K.DOWN
    g.t = 0
    g.count = 0
    g.countT = 0
    g.slow = 70
    g.hitstop = 10
    g.shake = 16.0
    g.hype = 1.0
    if (df == g.a) { g.downWho = 1 } else { g.downWho = 2 }
    sfx(g, K.S_KD)
    pop(g, "KNOCKDOWN", df.x, headY(df) - 30.0, 6, Color(255, 70, 60))
    burst(g, df.x, floorY(df.z) - 10.0, 14, 2, Color(220, 220, 230), 3.0)
    // CPU decide em que contagem levanta
    var r = 3 + df.kdTotal * 2 + rnd(g.r, 4) - stat(df.kind, 2)
    if (df.kd >= 3) { r = 99 }
    df.riseAt = clampi(r, 2, 99)
}

endFight(Game g, Int winner, String how, String sub) {
    g.winner = winner
    g.how = how
    g.sub = sub
    g.state = K.OVER
    g.t = 0
    var w = g.a
    if (winner == 2) { w = g.b }
    if (winner != 0) {
        w.st = K.WIN
        w.stT = 0
    }
    sfx(g, K.S_CHEER)
    g.mix.playMusic = true
}

// ---------------------------------------------------------------- juizes (10-9)
scoreJudge(Game g, Card c) {
    var a = g.a
    var b = g.b
    // atividade: golpes conectados, golpes de poder e dano (com o olhar de cada juiz)
    var sa = a.landedR * 10 + a.powerR * 12 + a.dmgR / 6 + rnd(g.r, 18) + c.bias * 4
    var sb = b.landedR * 10 + b.powerR * 12 + b.dmgR / 6 + rnd(g.r, 18) - c.bias * 4
    var act = 0
    if (sa > sb) { act = 1 }
    if (sb > sa) { act = 2 }
    var ra = 10
    var rb = 10
    var kdDiff = a.kdR - b.kdR
    if (kdDiff > 0) {
        ra = 9 - kdDiff
        if (act == 1) { ra = ra + 1 }
        if (ra >= 10) { ra = 9 }
    } else if (kdDiff < 0) {
        rb = 9 + kdDiff
        if (act == 2) { rb = rb + 1 }
        if (rb >= 10) { rb = 9 }
    } else if (act == 1) {
        rb = 9
    } else if (act == 2) {
        ra = 9
    }
    c.a[g.round] = clampi(ra, 6, 10)
    c.b[g.round] = clampi(rb, 6, 10)
}

Int cardTotal(Card c, Int side, Int upto) {
    var s = 0
    for (var i = 1; i <= upto; i++) {
        if (side == 1) { s = s + c.a[i] } else { s = s + c.b[i] }
    }
    return s
}

Int judgeWinner(Card c, Int rounds) {
    var ta = cardTotal(c, 1, rounds)
    var tb = cardTotal(c, 2, rounds)
    if (ta > tb) { return 1 }
    if (tb > ta) { return 2 }
    return 0
}

decision(Game g) {
    var w1 = judgeWinner(g.c1, g.rounds)
    var w2 = judgeWinner(g.c2, g.rounds)
    var w3 = judgeWinner(g.c3, g.rounds)
    var na = 0
    var nb = 0
    if (w1 == 1) { na = na + 1 }
    if (w2 == 1) { na = na + 1 }
    if (w3 == 1) { na = na + 1 }
    if (w1 == 2) { nb = nb + 1 }
    if (w2 == 2) { nb = nb + 1 }
    if (w3 == 2) { nb = nb + 1 }
    if (na == 3) {
        endFight(g, 1, "DECISAO UNANIME", "")
    } else if (nb == 3) {
        endFight(g, 2, "DECISAO UNANIME", "")
    } else if (na == 2 && nb == 1) {
        endFight(g, 1, "DECISAO DIVIDIDA", "")
    } else if (nb == 2 && na == 1) {
        endFight(g, 2, "DECISAO DIVIDIDA", "")
    } else if (na == 2) {
        endFight(g, 1, "DECISAO MAJORITARIA", "")
    } else if (nb == 2) {
        endFight(g, 2, "DECISAO MAJORITARIA", "")
    } else {
        endFight(g, 0, "EMPATE", "")
    }
}

endRound(Game g) {
    scoreJudge(g, g.c1)
    scoreJudge(g, g.c2)
    scoreJudge(g, g.c3)
    g.state = K.REND
    g.t = 0
    sfx(g, K.S_BELL)
    g.a.inG = false
    g.b.inG = false
}

nextRound(Game g) {
    if (g.round >= g.rounds) {
        decision(g)
        return
    }
    // intervalo no corner: recupera parte da energia
    var fs = listOf(g.a, g.b)
    for (var p in fs) {
        p.hp = imin(1000, p.hp + p.rec + 220)
        p.rec = 0
        p.lag = p.hp
        p.bodyDmg = imax(0, p.bodyDmg - 120)
        p.sta = staMax(p)
    }
    g.round = g.round + 1
    startRound(g)
}

// ---------------------------------------------------------------- simulacao do lutador
stepFighter(Game g, Fighter p, Fighter o) {
    if (p.flash > 0) { p.flash = p.flash - 1 }
    if (p.comboT > 0) { p.comboT = p.comboT - 1 }
    if (p.counterT > 0) { p.counterT = p.counterT - 1 }
    if (p.riseCool > 0) { p.riseCool = p.riseCool - 1 }
    p.snap = p.snap * 0.86
    // barra cinza (dano recuperavel) volta devagar
    if (p.hitCool > 0) {
        p.hitCool = p.hitCool - 1
    } else if (p.rec > 0 && g.frame % 5 == 0 && p.st != K.FALL) {
        p.rec = p.rec - 1
        p.hp = imin(1000, p.hp + 1)
    }
    if (p.lagT > 0) {
        p.lagT = p.lagT - 1
    } else if (p.lag > p.hp) {
        p.lag = imax(p.hp, p.lag - 6)
    }
    if (p.lag < p.hp) { p.lag = p.hp }
    p.stT = p.stT + 1

    if (p.st == K.FALL || p.st == K.WIN) { return }
    if (p.st == K.RISE) {
        if (p.stT >= 34) {
            p.st = K.IDLE
            p.stT = 0
        }
        return
    }
    if (p.st == K.HIT || p.st == K.BLOCKED) {
        if (p.stT >= p.stLen) {
            p.st = K.IDLE
            p.stT = 0
        }
    } else if (p.st == K.SLIP) {
        if (p.stT >= 22) {
            p.st = K.IDLE
            p.stT = 0
        }
    } else if (p.st == K.PUNCH) {
        if (!p.hitDone && p.stT >= startupOf(p)) {
            p.hitDone = true
            resolve(g, p, o)
            if (g.state != K.FIGHT) { return }
        }
        // janela de combo: encadeia o proximo golpe
        var chain = p.stLen - 8
        if (p.qPunch > 0 && p.stT >= chain && p.hitDone) {
            startPunch(g, p, p.qPunch)
        } else if (p.stT >= p.stLen) {
            p.st = K.IDLE
            p.stT = 0
        }
    }

    // fisica / movimento
    var spd = 2.0 + toD(stat(p.kind, 1)) * 0.32
    if (p.sta < 250) { spd = spd * 0.7 }
    var tx = 0.0
    var tz = 0.0
    if (p.st == K.IDLE) {
        if (o.x > p.x) { p.face = 1 } else { p.face = -1 }
        if (p.qSlip) {
            p.qSlip = false
            if (p.sta >= 40) {
                p.st = K.SLIP
                p.stT = 0
                p.sta = p.sta - 40
                sfx(g, K.S_WHOOSH)
            }
        } else if (p.qPunch > 0) {
            startPunch(g, p, p.qPunch)
        }
        if (p.st == K.IDLE) {
            var gm = 1.0
            if (p.inG) { gm = 0.45 }
            if (p.inL) { tx = tx - spd * gm }
            if (p.inR) { tx = tx + spd * gm }
            if (p.inU) { tz = tz - spd * gm * 0.55 }
            if (p.inD) { tz = tz + spd * gm * 0.55 }
        }
    }
    p.vx = p.vx + (tx - p.vx) * 0.25
    p.vz = p.vz + (tz - p.vz) * 0.25
    var nx = clampd(p.x + p.vx, toD(K.XMIN), toD(K.XMAX))
    var nz = clampd(p.z + p.vz, 0.0, 100.0)
    // nao atravessa o adversario
    if (dabs(nz - o.z) < 20.0 && dabs(nx - o.x) < 52.0 && o.st != K.FALL) {
        if (dabs(nx - o.x) < dabs(p.x - o.x)) { nx = p.x }
    }
    var moving = dabs(nx - p.x) + dabs(nz - p.z)
    p.walk = p.walk + moving * 0.09
    p.x = nx
    p.z = nz
    // folego
    var mx = staMax(p)
    var fol = stat(p.kind, 3)
    if (p.st == K.IDLE) {
        if (p.inG) {
            p.sta = imin(mx, p.sta + 1)
        } else if (moving > 0.3) {
            p.sta = imin(mx, p.sta + 1 + fol / 2)
        } else {
            p.sta = imin(mx, p.sta + 2 + fol)
        }
    }
    // inclinacao do tronco
    var target = 0.0
    if (p.st == K.PUNCH) { target = 0.6 }
    if (p.st == K.HIT) { target = -0.9 }
    if (p.st == K.SLIP) { target = -1.0 }
    if (p.inG && p.st == K.IDLE) { target = 0.2 }
    p.lean = p.lean + (target - p.lean) * 0.3
}

// ============================================================================
//  IA (estilos + adaptacao) E FLUXO DA LUTA
// ============================================================================

// estilo: 0 boxeador, 1 tanque, 2 contra-golpe, 3 pressao
Int aiAggr(Int k) {
    if (k == 0) { return 42 }
    if (k == 1) { return 30 }
    if (k == 2) { return 26 }
    return 66
}

Int aiDist(Int k) {
    if (k == 0) { return 104 }
    if (k == 1) { return 82 }
    if (k == 2) { return 94 }
    return 66
}

Int aiDef(Int k) {
    if (k == 0) { return 52 }
    if (k == 1) { return 34 }
    if (k == 2) { return 70 }
    return 30
}

Int aiSlip(Int k) {
    if (k == 0) { return 45 }
    if (k == 1) { return 8 }
    if (k == 2) { return 72 }
    return 15
}

String aiCombo(Game g, Int k, Bool oppGuard) {
    var r = rnd(g.r, 5)
    if (oppGuard && rnd(g.r, 100) < 60) {
        if (r < 2) { return "5" }
        if (r < 4) { return "53" }
        return "153"
    }
    if (k == 0) {
        if (r == 0) { return "1" }
        if (r == 1) { return "11" }
        if (r == 2) { return "12" }
        if (r == 3) { return "112" }
        return "1213"
    }
    if (k == 1) {
        if (r < 2) { return "12" }
        if (r == 2) { return "23" }
        if (r == 3) { return "53" }
        return "1"
    }
    if (k == 2) {
        if (r < 2) { return "2" }
        if (r == 2) { return "23" }
        if (r == 3) { return "34" }
        return "13"
    }
    if (r == 0) { return "53" }
    if (r == 1) { return "535" }
    if (r == 2) { return "343" }
    if (r == 3) { return "1234" }
    return "55"
}

Int reactFrames(Game g) {
    if (g.diff == 1) { return 9 }
    if (g.diff == 2) { return 5 }
    return 3
}

think(Game g, Fighter p, Fighter o) {
    var k = p.kind
    var react = reactFrames(g)
    // defesa reativa: le o preparo do golpe adversario
    var reading = false
    if (o.st == K.PUNCH && p.st == K.IDLE) {
        if (o.stT == imin(react, startupOf(o) - 1)) { reading = true }
    }
    if (reading) {
        var dist = dabs(o.x - p.x)
        if (dist < toD(pReach(o.punch) + 24)) {
            var tot = 1
            for (var i = 1; i <= 5; i++) { tot = tot + p.seen[i] }
            var adapt = p.seen[o.punch] * 100 / tot
            var chance = aiDef(k) * (g.diff + 1) / 3 + adapt / 3
            if (rnd(g.r, 100) < chance) {
                if (rnd(g.r, 100) < aiSlip(k) && p.sta > 80) {
                    p.qSlip = true
                } else {
                    p.aiGuard = 16 + stat(k, 4) * 3
                }
            }
        }
    }
    if (p.aiGuard > 0) {
        p.aiGuard = p.aiGuard - 1
        p.inG = true
    } else {
        p.inG = false
    }
    // pune depois de uma esquiva perfeita
    if (p.counterT > 0 && p.st == K.IDLE && p.qPunch == 0) {
        if (rnd(g.r, 2) == 0) { p.qPunch = K.CROSS } else { p.qPunch = K.HOOK }
        p.inMod = p.meter >= 100
        p.aiGuard = 0
    }
    // executa o combo planejado
    if (p.plan != "" && p.qPunch == 0 && p.aiGuard == 0) {
        if (p.st == K.IDLE || (p.st == K.PUNCH && p.hitDone)) {
            p.qPunch = digit(p.plan, p.planI)
            p.planI = p.planI + 1
            if (p.planI >= p.plan.length()) { p.plan = "" }
        }
    }
    if (p.aiT > 0) {
        p.aiT = p.aiT - 1
        return
    }
    p.aiT = react + rnd(g.r, 6)
    p.inL = false
    p.inR = false
    p.inU = false
    p.inD = false
    var dist = dabs(o.x - p.x)
    var dz = o.z - p.z
    var toward = 1
    if (o.x < p.x) { toward = -1 }
    // cansado ou machucado: recua e fecha a guarda
    if (p.sta < 220 || (p.hp < 200 && rnd(g.r, 100) < 45)) {
        if (toward > 0) { p.inL = true } else { p.inR = true }
        if (rnd(g.r, 2) == 0) { p.inU = true } else { p.inD = true }
        p.aiGuard = 24
        return
    }
    // alinha a profundidade
    if (dz > 6.0) { p.inD = true }
    if (dz < -6.0) { p.inU = true }
    // distancia ideal do estilo
    var ideal = toD(aiDist(k))
    if (dist > ideal + 14.0) {
        if (toward > 0) { p.inR = true } else { p.inL = true }
    } else if (dist < ideal - 18.0) {
        if (toward > 0) { p.inL = true } else { p.inR = true }
    }
    // o boxeador circula
    if (k == 0 && rnd(g.r, 100) < 25) {
        if (rnd(g.r, 2) == 0) { p.inU = true } else { p.inD = true }
    }
    // ataca (so se o primeiro golpe do combo alcanca)
    if (dabs(dz) <= 14.0 && p.plan == "" && p.st == K.IDLE) {
        var aggr = aiAggr(k) * (2 + g.diff) / 4
        if (o.st == K.HIT) { aggr = aggr + 30 }
        if (o.sta < 300) { aggr = aggr + 15 }
        if (k == 2 && o.st != K.PUNCH) { aggr = aggr - 8 }
        if (rnd(g.r, 100) < aggr) {
            var plan = aiCombo(g, k, o.inG)
            var first = digit(plan, 0)
            var reach = toD(pReach(first) + stat(k, 1) * 2) - 6.0
            if (dist <= reach) {
                p.plan = plan
                p.planI = 0
                p.inMod = p.meter >= 100 && (o.hp < 520 || rnd(g.r, 100) < 30)
            } else if (dist <= toD(pReach(K.JAB)) && rnd(g.r, 100) < 50) {
                p.plan = "1"
                p.planI = 0
            }
        }
    }
    // reaproxima rapido se o adversario foi empurrado para longe do alcance
    if (dist > ideal + 30.0 && g.diff >= 2) { p.aiT = imin(p.aiT, 3) }
}

// ---------------------------------------------------------------- levantar
Double riseMarker(Game g, Fighter p) {
    return sn(toD(g.t) * 0.075 * (1.0 + toD(p.kdTotal) * 0.3))
}

Double riseZone(Fighter p) {
    return clampd(0.42 - toD(p.kdTotal) * 0.09, 0.14, 0.42)
}

riseTry(Game g, Fighter p) {
    if (p.riseCool > 0 || p.st != K.FALL || p.stT < 45) { return }
    if (dabs(riseMarker(g, p)) < riseZone(p)) {
        p.riseOk = p.riseOk + 1
        p.riseCool = 12
        sfx(g, K.S_PING)
    } else {
        p.riseCool = 30
        sfx(g, K.S_BUZZ)
    }
}

rise(Game g, Fighter p) {
    var o = other(g, p)
    p.st = K.RISE
    p.stT = 0
    p.hp = imax(160, 520 - p.kdTotal * 110)
    p.lag = p.hp
    p.sta = imax(p.sta, 450)
    g.state = K.FIGHT
    g.t = 0
    sfx(g, K.S_OK)
    pop(g, "LEVANTOU", p.x, headY(p) - 30.0, 5, Color(120, 255, 160))
    if (o.x < p.x) {
        o.x = clampd(p.x - 170.0, toD(K.XMIN), toD(K.XMAX))
    } else {
        o.x = clampd(p.x + 170.0, toD(K.XMIN), toD(K.XMAX))
    }
}

stepDown(Game g) {
    var p = g.a
    if (g.downWho == 2) { p = g.b }
    var o = other(g, p)
    p.stT = p.stT + 1
    // quem derrubou vai para o corner neutro
    o.inL = false
    o.inR = false
    o.inU = false
    o.inD = false
    o.inG = false
    o.qPunch = 0
    o.plan = ""
    if (dabs(o.x - p.x) < 190.0) {
        if (o.x < p.x) { o.inL = true } else { o.inR = true }
    }
    stepFighter(g, o, p)
    if (p.stT < 45) { return }
    if (p.kd >= 3) {
        if (p.stT >= 80) {
            var w = 2
            if (g.downWho == 2) { w = 1 }
            endFight(g, w, "NOCAUTE TECNICO", "3 QUEDAS NO ROUND")
        }
        return
    }
    g.countT = g.countT + 1
    if (g.countT >= 54) {
        g.countT = 0
        g.count = g.count + 1
        sfx(g, K.S_TICK)
        if (g.count >= 10) {
            var w = 2
            if (g.downWho == 2) { w = 1 }
            endFight(g, w, "NOCAUTE", "CONTAGEM ATE 10")
            return
        }
    }
    if (!p.human) {
        if (g.count >= p.riseAt) { rise(g, p) }
    } else if (p.riseOk >= 3) {
        rise(g, p)
    }
}

// ---------------------------------------------------------------- loop principal
updateFx(Game g) {
    var keep = listOf<Part>()
    for (var p in g.parts) {
        p.t = p.t + 1
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.vy = p.vy + 0.22
        p.vx = p.vx * 0.97
        if (p.t < p.life) { keep.add(p) }
    }
    g.parts = keep
    var keep2 = listOf<Pop>()
    for (var q in g.pops) {
        q.t = q.t + 1
        q.y = q.y - 0.6
        if (q.t < q.life) { keep2.add(q) }
    }
    g.pops = keep2
    if (g.flashScr > 0) { g.flashScr = g.flashScr - 1 }
    g.shake = g.shake * 0.85
}

updateCamera(Game g) {
    var a = g.a
    var b = g.b
    var cx = (a.x + b.x) / 2.0
    var dist = dabs(a.x - b.x)
    var zt = clampd(1.32 - dist / 950.0, 1.0, 1.3)
    var cy = (floorY(a.z) + floorY(b.z)) / 2.0 - 110.0
    if (g.state == K.DOWN) {
        var p = a
        if (g.downWho == 2) { p = b }
        cx = p.x
        cy = floorY(p.z) - 70.0
        zt = 1.45
    }
    if (g.state == K.INTRO) {
        zt = 1.35 - toD(imin(g.t, 120)) / 120.0 * 0.25
    }
    if (g.state == K.OVER) {
        var w = a
        if (g.winner == 2) { w = b }
        if (g.winner != 0) {
            cx = w.x
            cy = floorY(w.z) - 120.0
            zt = 1.35
        }
    }
    if (g.state == K.TITLE || g.state == K.SELECT) {
        cx = 480.0
        cy = 330.0
        zt = 1.0
    }
    g.camX = g.camX + (cx - g.camX) * 0.08
    g.camY = g.camY + (cy - g.camY) * 0.08
    g.zoom = g.zoom + (zt - g.zoom) * 0.06
}

tick(Game g) {
    g.frame = g.frame + 1
    updateFx(g)
    updateCamera(g)
    if (!g.loaded) { g.loaded = loadStep(g.mix) }
    if (g.state == K.TITLE || g.state == K.SELECT || g.state == K.PAUSE) {
        g.t = g.t + 1
        return
    }
    if (g.hitstop > 0) {
        g.hitstop = g.hitstop - 1
        return
    }
    if (g.slow > 0) {
        g.slow = g.slow - 1
        if (g.frame % 3 != 0) { return }
    }
    g.t = g.t + 1
    g.hype = clampd(g.hype - 0.0015, 0.15, 1.0)
    if (g.state == K.INTRO) {
        if (g.t == 100) { sfx(g, K.S_BELL) }
        if (g.t >= 130) {
            g.state = K.FIGHT
            g.t = 0
        }
    } else if (g.state == K.FIGHT) {
        if (!g.a.human) { think(g, g.a, g.b) }
        if (!g.b.human) { think(g, g.b, g.a) }
        stepFighter(g, g.a, g.b)
        if (g.state == K.FIGHT) { stepFighter(g, g.b, g.a) }
        if (g.state == K.FIGHT) {
            g.clock = g.clock - 1
            if (g.clock <= 0) {
                g.clock = 0
                endRound(g)
            }
            // batimento cardiaco quando o jogador esta grogue
            var h = g.a
            if (!h.human) { h = g.b }
            if (h.human && h.hp < 230) {
                g.heartT = g.heartT - 1
                if (g.heartT <= 0) {
                    sfx(g, K.S_HEART)
                    g.heartT = 55
                }
            }
        }
    } else if (g.state == K.DOWN) {
        stepDown(g)
    } else if (g.state == K.REND) {
        if (g.t >= 420) { nextRound(g) }
    } else if (g.state == K.OVER) {
        var w = g.a
        if (g.winner == 2) { w = g.b }
        if (g.winner != 0) { w.stT = w.stT + 1 }
        var l = other(g, w)
        if (l.st == K.FALL) { l.stT = l.stT + 1 }
    }
}

// ---------------------------------------------------------------- entrada
confirm(Game g) {
    if (g.state == K.TITLE) {
        g.state = K.SELECT
        g.t = 0
        sfx(g, K.S_OK)
        g.mix.playMusic = true
    } else if (g.state == K.SELECT) {
        sfx(g, K.S_OK)
        startFight(g)
    } else if (g.state == K.REND) {
        nextRound(g)
    } else if (g.state == K.OVER && g.t > 60) {
        g.state = K.SELECT
        g.t = 0
        g.mix.playMusic = true
        g.mix.playCrowd = false
    }
}

togglePause(Game g) {
    if (g.state == K.FIGHT || g.state == K.DOWN || g.state == K.INTRO) {
        g.prevState = g.state
        g.state = K.PAUSE
        sfx(g, K.S_UI)
    } else if (g.state == K.PAUSE) {
        g.state = g.prevState
        sfx(g, K.S_UI)
    }
}

cycleSel(Game g, Int side, Int d) {
    if (g.state != K.SELECT) { return }
    if (side == 1) { g.sel1 = (g.sel1 + d + 4) % 4 } else { g.sel2 = (g.sel2 + d + 4) % 4 }
    sfx(g, K.S_UI)
}

press(Game g, Fighter p, Int type, Bool down) {
    if (!down) { return }
    if (g.state == K.DOWN) {
        var dn = g.a
        if (g.downWho == 2) { dn = g.b }
        if (dn == p && p.human) { riseTry(g, p) }
        return
    }
    if (g.state == K.FIGHT) { p.qPunch = type }
}

class Held {
    static String keys = ""
}

// repeticao do teclado nao dispara golpes em rajada
Bool edge(String k, Bool down) {
    var tagk = "[" + k + "]"
    var was = Held.keys.indexOf(tagk) >= 0
    if (down && !was) {
        Held.keys = Held.keys + tagk
        return true
    }
    if (!down && was) {
        var i = Held.keys.indexOf(tagk)
        Held.keys = Held.keys.substring(0, i) + Held.keys.substring(i + tagk.length(), Held.keys.length())
    }
    return false
}

onKey(Game g, String raw, Bool down) {
    var k = raw.toLowerCase()
    var fresh = edge(k, down)
    if (fresh && k == "enter") {
        confirm(g)
        return
    }
    if (fresh && (k == "p" || k == "escape")) {
        togglePause(g)
        return
    }
    if (fresh && k == "n") {
        g.mix.on = !g.mix.on
        return
    }
    if (fresh && k == "m") {
        g.mix.music = !g.mix.music
        return
    }
    if (g.state == K.SELECT && fresh) {
        if (k == "a") { cycleSel(g, 1, -1) }
        if (k == "d") { cycleSel(g, 1, 1) }
        if (k == "arrowleft") { cycleSel(g, 2, -1) }
        if (k == "arrowright") { cycleSel(g, 2, 1) }
        return
    }
    var a = g.a
    var b = g.b
    var solo = g.mode == 1
    // P1: WASD, J K L I U, espaco guarda, Q esquiva, R especial (1P: setas tambem andam)
    if (k == "a" || (solo && k == "arrowleft")) { a.inL = down }
    if (k == "d" || (solo && k == "arrowright")) { a.inR = down }
    if (k == "w" || (solo && k == "arrowup")) { a.inU = down }
    if (k == "s" || (solo && k == "arrowdown")) { a.inD = down }
    if (k == " " || k == "spacebar") { a.inG = down }
    if (k == "r") { a.inMod = down }
    if (fresh && k == "q") { a.qSlip = true }
    if (fresh && k == "j") { press(g, a, K.JAB, true) }
    if (fresh && k == "k") { press(g, a, K.CROSS, true) }
    if (fresh && k == "l") { press(g, a, K.HOOK, true) }
    if (fresh && k == "i") { press(g, a, K.UPPER, true) }
    if (fresh && k == "u") { press(g, a, K.BODY, true) }
    if (solo) { return }
    // P2: setas, 1 2 3 4 5, 0 guarda, . esquiva, 6 especial
    if (k == "arrowleft") { b.inL = down }
    if (k == "arrowright") { b.inR = down }
    if (k == "arrowup") { b.inU = down }
    if (k == "arrowdown") { b.inD = down }
    if (k == "0") { b.inG = down }
    if (k == "6") { b.inMod = down }
    if (fresh && (k == "." || k == ",")) { b.qSlip = true }
    if (fresh && k == "1") { press(g, b, K.JAB, true) }
    if (fresh && k == "2") { press(g, b, K.CROSS, true) }
    if (fresh && k == "3") { press(g, b, K.HOOK, true) }
    if (fresh && k == "4") { press(g, b, K.UPPER, true) }
    if (fresh && k == "5") { press(g, b, K.BODY, true) }
}

releaseAll(Fighter p) {
    p.inL = false
    p.inR = false
    p.inU = false
    p.inD = false
    p.inG = false
    p.inMod = false
}

// ============================================================================
//  GRAFICOS: ARENA, LUTADORES ARTICULADOS, PARTICULAS
// ============================================================================

// ---------------------------------------------------------------- arena
class Pt {
    Double x = 0.0
    Double y = 0.0
}

Pt pt(Double x, Double y) {
    var p = Pt()
    p.x = x
    p.y = y
    return p
}

drawBackground(Canvas c, Game g) {
    // fundo em faixas (degrade)
    var top = Color(8, 8, 22)
    var bot = Color(34, 16, 54)
    for (var i = 0; i < 12; i++) {
        var t = toD(i) / 11.0
        fillRect(c, -300.0, -200.0 + toD(i) * 60.0, 1560.0, 62.0, mix(top, bot, t))
    }
    // estrutura de luzes no teto (truss)
    line(c, -300.0, 6.0, 1260.0, 6.0, 6, Color(60, 60, 80))
    line(c, -300.0, 20.0, 1260.0, 20.0, 3, Color(50, 50, 70))
    for (var i = 0; i < 16; i++) {
        var lx = -60.0 + toD(i) * 70.0
        line(c, lx, 6.0, lx + 35.0, 20.0, 2, Color(50, 50, 70))
        var on = (i + g.frame / 30) % 4 != 0 || g.hype > 0.6
        var lc = Color(90, 90, 110)
        if (on) { lc = Color(255, 245, 220) }
        circle(c, lx + 17.0, 30.0, 6.0, Color(30, 30, 40))
        circle(c, lx + 17.0, 32.0, 4.0, lc)
    }
}

drawCrowd(Canvas c, Game g) {
    var hype = g.hype
    for (var row = 0; row < 4; row++) {
        var y = 168.0 + toD(row) * 34.0
        var sz = 0.7 + toD(row) * 0.13
        var cols = 30 - row * 2
        var dark = 26 + row * 9
        for (var i = 0; i < cols; i++) {
            var x = -60.0 + (toD(i) + toD(row % 2) * 0.5) * (1080.0 / toD(cols))
            var seed = (i * 37 + row * 101) % 17
            var bob = sn(toD(g.frame) * (0.08 + hype * 0.12) + toD(seed)) * (1.0 + hype * 5.0)
            var col = Color(dark + seed, dark - 6 + seed / 2, dark + 22 + seed)
            circle(c, x, y + 26.0 * sz, 15.0 * sz, col)
            circle(c, x, y + bob * sz, 9.0 * sz, col)
            // bracos para cima quando a torcida vibra
            if (hype > 0.55 && (seed + g.frame / 20) % 5 == 0) {
                limb(c, x - 8.0 * sz, y + 18.0 * sz, x - 13.0 * sz, y - 14.0 * sz + bob, toI(5.0 * sz), col)
                limb(c, x + 8.0 * sz, y + 18.0 * sz, x + 13.0 * sz, y - 14.0 * sz + bob, toI(5.0 * sz), col)
            }
        }
    }
    // celulares e flashes
    var n = 6 + toI(hype * 26.0)
    for (var k = 0; k < n; k++) {
        var h = (k * 7919 + (g.frame / 9) * 104729) % 100000
        var x = toD(h % 1000)
        var y = 160.0 + toD((h / 1000) % 130)
        var tw = (g.frame + k * 13) % 40
        if (tw < 4) {
            alpha(c, 0.9)
            circle(c, x, y, 3.0, Color(255, 255, 240))
            alpha(c, 0.25)
            circle(c, x, y, 9.0, Color(255, 255, 240))
        } else {
            alpha(c, 0.35)
            fillRect(c, x - 1.5, y - 2.5, 3.0, 5.0, Color(170, 210, 255))
        }
    }
    alpha(c, 1.0)
}

drawSpots(Canvas c, Game g) {
    for (var i = 0; i < 4; i++) {
        var baseX = 150.0 + toD(i) * 220.0
        var sway = sn(toD(g.frame) * 0.012 + toD(i) * 1.7) * 90.0
        var tx = baseX + sway
        var col = Color(170, 200, 255)
        if (i == 1) { col = Color(255, 140, 220) }
        if (i == 2) { col = Color(140, 255, 230) }
        alpha(c, 0.045 + g.hype * 0.04)
        fillTri(c, toI(baseX), -40, toI(tx - 110.0), 470, toI(tx + 110.0), 470, col)
        alpha(c, 0.06)
        ellipse(c, tx, 410.0, 120.0, 26.0, col)
    }
    alpha(c, 1.0)
}

drawLedBoard(Canvas c, Game g, Double y, Double h, Int sz) {
    fillRect(c, -300.0, y, 1560.0, h, Color(6, 6, 14))
    var msg = "RINGUE KOF 90'S  *  POWERED BY KOF  *  HOMENAGEM A REALSPORTS BOXING 1987  *  "
    var w = textW(msg, sz) + 6 * sz
    var off = (g.frame * 2) % w
    var hue = (g.frame / 3) % 360
    var col = Color(80 + toI(70.0 * (1.0 + sn(toD(hue) * 0.0175))), 200, 255)
    var ty = toI(y + (h - toD(6 * sz)) / 2.0)
    var x0 = -off
    while (x0 > -300) { x0 = x0 - w }
    var xx = x0
    while (xx < 1260) {
        text(c, msg, xx, ty, sz, imax(1, sz / 2 + 1), col)
        xx = xx + w
    }
    alpha(c, 0.15)
    fillRect(c, -300.0, y, 1560.0, 2.0, Color(255, 255, 255))
    alpha(c, 1.0)
}

drawRingBack(Canvas c, Game g) {
    alpha(c, 0.75)
    drawLedBoard(c, g, 298.0, 18.0, 2)
    alpha(c, 1.0)
    // postes do fundo
    limb(c, 190.0, 226.0, 190.0, 320.0, 9, Color(190, 190, 205))
    limb(c, 770.0, 226.0, 770.0, 320.0, 9, Color(190, 190, 205))
    var cols = listOf(Color(240, 240, 245), Color(220, 40, 60), Color(40, 90, 230))
    for (var i = 0; i < 3; i++) {
        var y = 244.0 + toD(i) * 24.0
        line(c, 190.0, y, 480.0, y + 3.0, 4, cols.get(i))
        line(c, 480.0, y + 3.0, 770.0, y, 4, cols.get(i))
    }
    // tablado
    fillQuad(c, 190, 318, 770, 318, 920, 484, 40, 484, Color(18, 52, 112))
    fillQuad(c, 214, 324, 746, 324, 884, 474, 76, 474, Color(26, 74, 150))
    alpha(c, 0.10)
    textC(c, "KOF", 480, 372, 14, 6, Color(150, 200, 255))
    alpha(c, 1.0)
    // poca de luz sob os lutadores
    var fs = listOf(g.a, g.b)
    for (var p in fs) {
        alpha(c, 0.10 + g.hype * 0.05)
        ellipse(c, p.x, floorY(p.z) + 2.0, 95.0, 22.0, Color(200, 220, 255))
    }
    alpha(c, 0.35)
    line(c, 40.0, 484.0, 920.0, 484.0, 3, Color(120, 170, 255))
    alpha(c, 1.0)
}

drawRingFront(Canvas c, Game g) {
    var cols = listOf(Color(240, 240, 245), Color(220, 40, 60), Color(40, 90, 230))
    alpha(c, 0.92)
    for (var i = 0; i < 3; i++) {
        var y = 392.0 + toD(i) * 27.0
        line(c, 40.0, y, 480.0, y + 6.0, 6, cols.get(i))
        line(c, 480.0, y + 6.0, 920.0, y, 6, cols.get(i))
    }
    alpha(c, 1.0)
    limb(c, 40.0, 372.0, 40.0, 500.0, 14, Color(200, 200, 215))
    limb(c, 920.0, 372.0, 920.0, 500.0, 14, Color(200, 200, 215))
    // protetores dos corners
    fillRect(c, 30.0, 380.0, 20.0, 74.0, Color(220, 40, 60))
    fillRect(c, 910.0, 380.0, 20.0, 74.0, Color(40, 90, 230))
    alpha(c, 0.3)
    fillRect(c, 32.0, 382.0, 5.0, 70.0, Color(255, 255, 255))
    fillRect(c, 912.0, 382.0, 5.0, 70.0, Color(255, 255, 255))
    alpha(c, 1.0)
    // saia do ringue com LED
    fillRect(c, -300.0, 486.0, 1560.0, 140.0, Color(10, 8, 20))
    drawLedBoard(c, g, 496.0, 34.0, 3)
}

// ---------------------------------------------------------------- lutador
// cotovelo por cinemática inversa (dois segmentos iguais)
Pt elbow(Double sx, Double sy, Double hx, Double hy, Double len, Double dir) {
    var dx = hx - sx
    var dy = hy - sy
    var d = math.sqrt(dx * dx + dy * dy)
    if (d < 1.0) { d = 1.0 }
    var maxd = len * 2.0 - 0.5
    if (d > maxd) { d = maxd }
    var a = d / 2.0
    var h = math.sqrt(clampd(len * len - a * a, 0.0, 99999.0))
    var bx = sx + dx * a / d
    var by = sy + dy * a / d
    return pt(bx - dy / d * h * dir, by + dx / d * h * dir)
}

drawArm(Canvas c, Double sx, Double sy, Double gx, Double gy, Double dir, Color skin, Color glove, Bool star, Int frame) {
    var e = elbow(sx, sy, gx, gy, 31.0, dir)
    limb(c, sx, sy, e.x, e.y, 13, skin)
    limb(c, e.x, e.y, gx, gy, 11, skin)
    if (star) {
        alpha(c, 0.35 + 0.25 * sn(toD(frame) * 0.6))
        circle(c, gx, gy, 24.0, Color(255, 220, 60))
        alpha(c, 1.0)
    }
    circle(c, gx - 2.0, gy, 8.0, Color(245, 245, 245))
    circle(c, gx + 3.0, gy, 13.0, shade(glove, 70))
    circle(c, gx + 4.0, gy - 1.0, 11.5, glove)
    alpha(c, 0.45)
    circle(c, gx + 7.0, gy - 5.0, 4.0, Color(255, 255, 255))
    alpha(c, 1.0)
}

Double punchExt(Fighter p) {
    var s = toD(startupOf(p))
    var a = toD(pAct(p.punch))
    var r = toD(pRec(p.punch))
    var t = toD(p.stT)
    if (t < s) { return easeOut(t / s) }
    if (t < s + a) { return 1.0 }
    return 1.0 - easeOut((t - s - a) / r)
}

drawHead(Canvas c, Game g, Fighter p, Double hx, Double hy, Bool ko) {
    var k = p.kind
    var skin = skinC(k)
    var hair = hairC(k)
    var dark = shade(skin, 72)
    var ink = Color(18, 16, 22)
    // pescoco
    limb(c, hx - 6.0, hy + 12.0, hx - 8.0, hy + 26.0, 14, dark)
    // cabeca com sombreamento
    circle(c, hx, hy, 18.0, dark)
    circle(c, hx + 1.5, hy - 1.5, 16.5, skin)
    // cabelo / barba por lutador
    if (k == 0) {
        c.setFill(hair)
        c.beginPath()
        c.arc(toI(hx), toI(hy - 1.0), 18, 3.3, 6.2)
        c.fill()
        circle(c, hx - 12.0, hy - 4.0, 7.0, hair)
    } else if (k == 1) {
        alpha(c, 0.35)
        circle(c, hx + 5.0, hy - 9.0, 5.0, Color(255, 255, 255))
        alpha(c, 1.0)
        c.setFill(hair)
        c.beginPath()
        c.arc(toI(hx + 3.0), toI(hy + 4.0), 16, 0.2, 2.6)
        c.fill()
    } else if (k == 2) {
        for (var i = 0; i < 5; i++) {
            var bx = hx - 14.0 + toD(i) * 7.0
            fillTri(c, toI(bx - 5.0), toI(hy - 8.0), toI(bx + 5.0), toI(hy - 8.0), toI(bx + 2.0), toI(hy - 27.0 + toD(i % 2) * 4.0), hair)
        }
        c.setFill(hair)
        c.beginPath()
        c.arc(toI(hx), toI(hy - 2.0), 18, 3.3, 6.2)
        c.fill()
    } else {
        c.setFill(hair)
        c.beginPath()
        c.arc(toI(hx), toI(hy - 2.0), 17, 3.4, 6.1)
        c.fill()
        alpha(c, 0.5)
        c.setFill(hair)
        c.beginPath()
        c.arc(toI(hx + 2.0), toI(hy + 5.0), 15, 0.3, 2.4)
        c.fill()
        alpha(c, 1.0)
    }
    // orelha
    circle(c, hx - 5.0, hy + 1.0, 4.5, dark)
    // nariz
    fillTri(c, toI(hx + 15.0), toI(hy - 2.0), toI(hx + 21.0), toI(hy + 5.0), toI(hx + 14.0), toI(hy + 6.0), skin)
    // olho (perfil) - fechado se piscando, atordoado ou nocauteado
    var blink = (g.frame + k * 53) % 150 < 4
    if (ko) {
        line(c, hx + 5.0, hy - 6.0, hx + 11.0, hy, 2, ink)
        line(c, hx + 11.0, hy - 6.0, hx + 5.0, hy, 2, ink)
    } else if (blink || p.st == K.HIT) {
        line(c, hx + 5.0, hy - 2.0, hx + 12.0, hy - 2.0, 2, ink)
    } else {
        ellipse(c, hx + 9.0, hy - 3.0, 4.5, 3.4, Color(250, 250, 250))
        circle(c, hx + 10.5, hy - 3.0, 2.2, ink)
    }
    // sobrancelha (bravo no ataque, erguida quando apanha)
    var by = -9.0
    var tilt = 2.0
    if (p.st == K.PUNCH) { tilt = 4.0 }
    if (p.st == K.HIT) {
        by = -11.0
        tilt = -2.0
    }
    line(c, hx + 3.0, hy + by - tilt / 2.0, hx + 14.0, hy + by + tilt / 2.0, 3, shade(hair, 90))
    // boca: protetor bucal aparece quando apanha
    if (p.st == K.HIT && p.stT < 8) {
        fillRect(c, hx + 8.0, hy + 7.0, 8.0, 4.0, Color(240, 240, 255))
    } else {
        line(c, hx + 9.0, hy + 9.0, hx + 14.0, hy + 8.0, 2, shade(skin, 55))
    }
    if (p.flash > 0) {
        alpha(c, toD(p.flash) / 8.0)
        circle(c, hx, hy, 18.0, Color(255, 255, 255))
        alpha(c, 1.0)
    }
}

drawFighter(Canvas c, Game g, Fighter p) {
    var sc = scaleZ(p.z)
    var fx = p.x
    var fy = floorY(p.z)
    var k = p.kind
    var skin = skinC(k)
    var dark = shade(skin, 72)
    var trunk = trunkC(k)
    var trim = trimC(k)
    var glove = gloveC(k)
    // sombra
    alpha(c, 0.4)
    ellipse(c, fx, fy + 2.0, 50.0 * sc, 11.0 * sc, Color(0, 0, 10))
    alpha(c, 1.0)
    c.save()
    c.transform(toD(p.face) * sc, 0.0, 0.0, sc, fx, fy)
    // queda / levantar: gira o corpo em torno dos pes
    var ko = false
    if (p.st == K.FALL || p.st == K.RISE) {
        var u = easeOut(toD(p.stT) / 26.0)
        if (p.st == K.RISE) { u = 1.0 - easeOut(toD(p.stT) / 32.0) }
        var ang = -1.52 * u
        var bounce = 0.0
        if (p.st == K.FALL && p.stT > 22 && p.stT < 34) { bounce = -sn(toD(p.stT - 22) / 12.0 * K.PI) * 8.0 }
        c.transform(cs(ang), sn(ang), -sn(ang), cs(ang), -30.0 * u, -14.0 * u + bounce)
        ko = p.st == K.FALL && p.stT > 20
    }
    var bob = sn(toD(g.frame) * 0.11 + toD(k)) * 2.5
    var walk = sn(p.walk)
    var lx = p.lean * 10.0
    var dip = 0.0
    var slipX = 0.0
    var slipY = 0.0
    if (p.st == K.SLIP) {
        var u2 = sn(toD(p.stT) / 22.0 * K.PI)
        slipX = -22.0 * u2
        slipY = 10.0 * u2
    }
    if (p.st == K.PUNCH && (p.punch == K.BODY || p.punch == K.UPPER)) { dip = 7.0 * punchExt(p) }
    if (p.st == K.WIN) { bob = -dabs(sn(toD(p.stT) * 0.15)) * 10.0 }
    var hipY = -94.0 + bob * 0.4 + dip
    var neckX = lx + 4.0 + slipX * 0.6
    var neckY = -150.0 + bob + dip + slipY * 0.6
    // pernas
    var bfx = -22.0 + walk * 7.0
    var ffx = 22.0 - walk * 7.0
    var bk = elbow(-9.0, hipY + 14.0, bfx, -4.0, 30.0, 1.0)
    var fk = elbow(9.0, hipY + 14.0, ffx, -4.0, 30.0, 1.0)
    limb(c, -9.0, hipY + 14.0, bk.x, bk.y, 16, dark)
    limb(c, bk.x, bk.y, bfx, -4.0, 13, dark)
    limb(c, bfx - 2.0, -3.0, bfx + 12.0, -3.0, 9, Color(30, 30, 36))
    // braco de tras (atras do tronco)
    var srx = neckX - 12.0
    var sry = neckY + 4.0
    var sfx = neckX + 12.0
    var sfy = neckY + 6.0
    var gfx = 36.0 + lx
    var gfy = -164.0 + bob + dip
    var grx = 22.0 + lx
    var gry = -152.0 + bob + dip
    var dirF = 1.0
    var dirR = 1.0
    if (p.inG && (p.st == K.IDLE || p.st == K.BLOCKED)) {
        gfx = 28.0 + lx
        gfy = -180.0 + bob
        grx = 22.0 + lx
        gry = -170.0 + bob
    }
    if (p.st == K.PUNCH) {
        var e = punchExt(p)
        if (p.punch == K.JAB) {
            gfx = lerpd(gfx, 44.0 + 92.0, e)
            gfy = lerpd(gfy, -168.0, e)
        } else if (p.punch == K.CROSS) {
            grx = lerpd(grx, 48.0 + 96.0, e)
            gry = lerpd(gry, -166.0, e)
        } else if (p.punch == K.HOOK) {
            gfx = lerpd(gfx, 104.0, e)
            gfy = lerpd(gfy, -168.0, e) - sn(e * K.PI) * 20.0
            dirF = -1.0
        } else if (p.punch == K.UPPER) {
            grx = lerpd(26.0, 88.0, e)
            gry = lerpd(-118.0, -196.0, e)
        } else {
            grx = lerpd(grx, 46.0 + 80.0, e)
            gry = lerpd(gry, -124.0, e)
        }
    }
    if (p.st == K.WIN) {
        gfx = 22.0
        gfy = -232.0 + bob
        grx = -8.0
        gry = -228.0 + bob
        dirF = -1.0
        dirR = -1.0
    }
    if (p.st == K.HIT) {
        gfx = gfx - 10.0
        grx = grx - 8.0
    }
    if (ko) {
        gfx = 10.0
        gfy = -110.0
        grx = -10.0
        gry = -100.0
    }
    drawArm(c, srx, sry, grx, gry, dirR, dark, shade(glove, 85), p.star && p.st == K.PUNCH && p.punch != K.JAB && p.punch != K.HOOK, g.frame)
    // tronco com sombreamento
    fillQuad(c, toI(neckX - 26.0), toI(neckY + 2.0), toI(neckX + 24.0), toI(neckY + 4.0), toI(lx * 0.4 + 20.0), toI(hipY + 4.0), toI(lx * 0.4 - 20.0), toI(hipY + 4.0), dark)
    fillQuad(c, toI(neckX - 21.0), toI(neckY + 5.0), toI(neckX + 22.0), toI(neckY + 6.0), toI(lx * 0.4 + 17.0), toI(hipY + 2.0), toI(lx * 0.4 - 15.0), toI(hipY + 2.0), skin)
    alpha(c, 0.22)
    line(c, neckX + 2.0, neckY + 18.0, lx * 0.4 + 2.0, hipY - 6.0, 2, shade(skin, 50))
    ellipse(c, neckX + 8.0, neckY + 16.0, 9.0, 6.0, Color(255, 255, 255))
    alpha(c, 1.0)
    // calcao
    fillQuad(c, toI(lx * 0.4 - 23.0), toI(hipY - 4.0), toI(lx * 0.4 + 23.0), toI(hipY - 4.0), toI(28.0), toI(hipY + 34.0), toI(-28.0), toI(hipY + 34.0), trunk)
    fillRect(c, lx * 0.4 - 23.0, hipY - 6.0, 46.0, 7.0, trim)
    alpha(c, 0.25)
    fillQuad(c, toI(lx * 0.4 - 23.0), toI(hipY - 4.0), toI(lx * 0.4 - 10.0), toI(hipY - 4.0), toI(-14.0), toI(hipY + 34.0), toI(-28.0), toI(hipY + 34.0), Color(0, 0, 0))
    alpha(c, 1.0)
    // perna da frente
    limb(c, 9.0, hipY + 14.0, fk.x, fk.y, 16, skin)
    limb(c, fk.x, fk.y, ffx, -4.0, 13, skin)
    limb(c, ffx - 2.0, -3.0, ffx + 13.0, -3.0, 10, Color(245, 245, 250))
    // cabeca
    var hx = neckX + 8.0 - p.snap * 14.0 + slipX
    var hy = neckY - 26.0 + slipY - p.snap * 3.0
    drawHead(c, g, p, hx, hy, ko)
    // braco da frente
    drawArm(c, sfx, sfy, gfx, gfy, dirF, skin, glove, p.star && p.st == K.PUNCH && (p.punch == K.JAB || p.punch == K.HOOK), g.frame)
    c.restore()
}

// ---------------------------------------------------------------- particulas e textos
drawParts(Canvas c, Game g) {
    for (var p in g.parts) {
        var f = 1.0 - toD(p.t) / toD(p.life)
        alpha(c, f)
        if (p.kind == 0) {
            circle(c, p.x, p.y, p.r, p.col)
        } else if (p.kind == 1) {
            line(c, p.x, p.y, p.x - p.vx * 3.0, p.y - p.vy * 3.0, 2, p.col)
        } else {
            circle(c, p.x, p.y, p.r * (2.0 + toD(p.t) / 6.0), p.col)
        }
    }
    alpha(c, 1.0)
}

drawPops(Canvas c, Game g) {
    for (var q in g.pops) {
        var a = 1.0
        if (q.t > q.life - 20) { a = toD(q.life - q.t) / 20.0 }
        var sz = q.sz
        if (q.t < 6) { sz = imax(1, q.sz * (q.t + 2) / 8) }
        alpha(c, a)
        textGlow(c, q.s, toI(q.x), toI(q.y), sz, imax(2, sz / 2 + 1), Color(255, 255, 255), q.col)
    }
    alpha(c, 1.0)
}

drawWorld(Canvas c, Game g) {
    var z = g.zoom
    var sx = (rndd(g.r) - 0.5) * g.shake * 2.0
    var sy = (rndd(g.r) - 0.5) * g.shake * 2.0
    c.save()
    c.transform(z, 0.0, 0.0, z, 480.0 - g.camX * z + sx, 300.0 - g.camY * z + sy)
    drawBackground(c, g)
    drawSpots(c, g)
    drawCrowd(c, g)
    drawRingBack(c, g)
    if (g.state == K.TITLE) {
        // os dois lutadores se encarando na abertura
        Prev.A.kind = g.sel1
        Prev.B.kind = g.sel2
        Prev.A.x = 400.0
        Prev.A.z = 62.0
        Prev.A.face = 1
        Prev.B.x = 560.0
        Prev.B.z = 62.0
        Prev.B.face = -1
        Prev.A.inG = true
        Prev.B.inG = true
        drawFighter(c, g, Prev.A)
        drawFighter(c, g, Prev.B)
    }
    if (g.state != K.TITLE && g.state != K.SELECT) {
        if (g.a.z <= g.b.z) {
            drawFighter(c, g, g.a)
            drawFighter(c, g, g.b)
        } else {
            drawFighter(c, g, g.b)
            drawFighter(c, g, g.a)
        }
    }
    drawRingFront(c, g)
    drawParts(c, g)
    drawPops(c, g)
    c.restore()
}

// ============================================================================
//  HUD, TELAS E MAIN
// ============================================================================

class Prev {
    static Fighter A = Fighter()
    static Fighter B = Fighter()
}

panel(Canvas c, Double x, Double y, Double w, Double h, Double a) {
    alpha(c, a)
    fillQuad(c, toI(x + 10.0), toI(y), toI(x + w), toI(y), toI(x + w - 10.0), toI(y + h), toI(x), toI(y + h), Color(6, 6, 18))
    alpha(c, a * 0.8)
    line(c, x + 10.0, y, x + w, y, 2, Color(110, 90, 255))
    alpha(c, 1.0)
}

// barra inclinada (paralelogramo) que enche da esquerda ou da direita
slantBar(Canvas c, Double x, Double y, Double w, Double h, Double frac, Bool rtl, Color col) {
    var f = clampd(frac, 0.0, 1.0)
    var fw = w * f
    var x0 = x
    if (rtl) { x0 = x + w - fw }
    if (fw < 1.0) { return }
    fillQuad(c, toI(x0 + h * 0.5), toI(y), toI(x0 + fw + h * 0.5), toI(y), toI(x0 + fw), toI(y + h), toI(x0), toI(y + h), col)
}

Color hpColor(Int hp) {
    var t = toD(hp) / 1000.0
    if (t > 0.5) { return mix(Color(255, 210, 40), Color(60, 230, 120), (t - 0.5) * 2.0) }
    return mix(Color(240, 40, 50), Color(255, 210, 40), t * 2.0)
}

drawFighterHud(Canvas c, Game g, Fighter p, Bool right) {
    var x = 24.0
    if (right) { x = 556.0 }
    panel(c, x - 8.0, 10.0, 396.0, 72.0, 0.55)
    var name = fName(p.kind)
    if (right) {
        text(c, name, toI(x + 380.0) - textW(name, 3), 18, 3, 2, Color(255, 255, 255))
    } else {
        text(c, name, toI(x), 18, 3, 2, Color(255, 255, 255))
    }
    // energia: trilho, dano recuperavel (cinza), atraso (branco) e vida
    var bw = 360.0
    var bx = x
    if (right) { bx = x + 20.0 }
    alpha(c, 0.7)
    slantBar(c, bx, 38.0, bw, 14.0, 1.0, right, Color(30, 30, 44))
    alpha(c, 1.0)
    slantBar(c, bx, 38.0, bw, 14.0, toD(p.hp + p.rec) / 1000.0, right, Color(110, 110, 125))
    slantBar(c, bx, 38.0, bw, 14.0, toD(p.lag) / 1000.0, right, Color(255, 245, 230))
    slantBar(c, bx, 38.0, bw, 14.0, toD(imax(0, p.hp)) / 1000.0, right, hpColor(p.hp))
    alpha(c, 0.25)
    slantBar(c, bx, 38.0, bw, 4.0, toD(imax(0, p.hp)) / 1000.0, right, Color(255, 255, 255))
    alpha(c, 1.0)
    // folego
    alpha(c, 0.6)
    slantBar(c, bx, 56.0, bw * 0.8, 5.0, 1.0, right, Color(24, 30, 40))
    alpha(c, 1.0)
    var sx = bx
    if (right) { sx = bx + bw * 0.2 }
    slantBar(c, sx, 56.0, bw * 0.8, 5.0, toD(p.sta) / 1000.0, right, Color(70, 210, 255))
    // especial em 4 segmentos
    var seg = p.meter / 25
    for (var i = 0; i < 4; i++) {
        var on = i < seg
        var col = Color(60, 54, 30)
        if (on) { col = Color(255, 200, 50) }
        if (p.meter >= 100 && (g.frame / 6) % 2 == 0) { col = Color(255, 250, 170) }
        var px = bx + toD(i) * 26.0
        if (right) { px = bx + bw - 24.0 - toD(i) * 26.0 }
        fillQuad(c, toI(px + 3.0), 66, toI(px + 24.0), 66, toI(px + 21.0), 73, toI(px), 73, col)
    }
    if (p.meter >= 100) {
        var lbl = "ESPECIAL"
        var lx = toI(bx + 110.0)
        if (right) { lx = toI(bx + bw - 110.0) - textW(lbl, 2) }
        alpha(c, 0.6 + 0.4 * sn(toD(g.frame) * 0.3))
        text(c, lbl, lx, 66, 2, 2, Color(255, 230, 90))
        alpha(c, 1.0)
    }
    // quedas no round
    for (var i = 0; i < p.kd; i++) {
        var kx = x + 250.0 + toD(i) * 14.0
        if (right) { kx = x + 110.0 - toD(i) * 14.0 }
        circle(c, kx, 22.0, 5.0, Color(255, 70, 60))
    }
    if (p.combo >= 2 && p.comboT > 0) {
        var ctext = "COMBO X" + p.combo
        var cx = toI(x)
        if (right) { cx = toI(x + 380.0) - textW(ctext, 3) }
        text(c, ctext, cx, 92, 3, 2, Color(255, 200, 70))
    }
}

drawTimer(Canvas c, Game g) {
    alpha(c, 0.7)
    circle(c, 480.0, 46.0, 36.0, Color(6, 6, 18))
    alpha(c, 1.0)
    var f = toD(g.clock) / toD(g.roundLen)
    arcStroke(c, 480.0, 46.0, 31.0, 0.0, K.TAU, 5, Color(40, 40, 60))
    var col = Color(110, 230, 255)
    if (g.clock < 600) { col = Color(255, 80, 70) }
    arcStroke(c, 480.0, 46.0, 31.0, -K.PI / 2.0, -K.PI / 2.0 + K.TAU * f, 5, col)
    var secs = (g.clock + 59) / 60
    textC(c, (secs / 60) + ":" + two(secs % 60), 480, 34, 3, 3, Color(255, 255, 255))
    textC(c, "R" + g.round + "/" + g.rounds, 480, 58, 2, 2, Color(190, 190, 220))
}

drawHud(Canvas c, Game g) {
    drawFighterHud(c, g, g.a, false)
    drawFighterHud(c, g, g.b, true)
    drawTimer(c, g)
    if (g.state == K.FIGHT && g.round == 1 && g.clock > g.roundLen - 420) {
        var msg = "J JAB  K DIRETO  L GANCHO  I UPPER  U CORPO  ESPACO GUARDA  Q ESQUIVA  R ESPECIAL"
        alpha(c, 0.8)
        panel(c, 40.0, 506.0, 880.0, 26.0, 0.7)
        textC(c, msg, 480, 512, 2, 2, Color(220, 220, 255))
        alpha(c, 1.0)
    }
}

dim(Canvas c, Double a) {
    alpha(c, a)
    fillRect(c, 0.0, 0.0, 960.0, 540.0, Color(4, 4, 14))
    alpha(c, 1.0)
}

drawIntro(Canvas c, Game g) {
    var t = g.t
    alpha(c, clampd(toD(t) / 15.0, 0.0, 1.0))
    textGlow(c, "ROUND " + g.round, 480, 110, 9, 5, Color(255, 255, 255), Color(255, 60, 140))
    if (g.round == 1) {
        var vs = fName(g.a.kind) + "  VS  " + fName(g.b.kind)
        textGlow(c, vs, 480, 182, 3, 2, Color(255, 255, 255), Color(80, 140, 255))
    }
    if (t > 96) { textGlow(c, "LUTEM", 480, 440, 7, 4, Color(255, 230, 90), Color(255, 120, 40)) }
    alpha(c, 1.0)
}

drawDown(Canvas c, Game g) {
    var p = g.a
    if (g.downWho == 2) { p = g.b }
    if (p.stT >= 45 && g.count > 0 && p.kd < 3) {
        var n = "" + g.count
        textGlow(c, n, 480, 120, 16, 7, Color(255, 255, 255), Color(255, 60, 60))
    }
    if (p.human && p.stT >= 45 && p.kd < 3) {
        panel(c, 250.0, 430.0, 460.0, 92.0, 0.75)
        textC(c, "APERTE UM SOCO NA HORA CERTA", 480, 440, 2, 2, Color(255, 255, 255))
        var bx = 290.0
        var bw = 380.0
        fillRect(c, bx, 466.0, bw, 16.0, Color(40, 40, 60))
        var z = riseZone(p)
        alpha(c, 0.85)
        fillRect(c, bx + bw * (0.5 - z / 2.0), 466.0, bw * z, 16.0, Color(60, 220, 120))
        alpha(c, 1.0)
        var mx = bx + bw * (0.5 + riseMarker(g, p) / 2.0)
        fillRect(c, mx - 3.0, 460.0, 6.0, 28.0, Color(255, 255, 255))
        for (var i = 0; i < 3; i++) {
            var col = Color(60, 60, 80)
            if (i < p.riseOk) { col = Color(255, 220, 60) }
            circle(c, 456.0 + toD(i) * 24.0, 502.0, 7.0, col)
        }
    }
}

drawRoundEnd(Canvas c, Game g) {
    dim(c, 0.45)
    panel(c, 220.0, 110.0, 520.0, 330.0, 0.85)
    textGlow(c, "FIM DO ROUND " + g.round, 480, 128, 6, 3, Color(255, 255, 255), Color(255, 60, 140))
    text(c, fName(g.a.kind), 300, 190, 2, 2, trunkC(g.a.kind))
    var nb = fName(g.b.kind)
    text(c, nb, 690 - textW(nb, 2), 190, 2, 2, trunkC(g.b.kind))
    var cards = listOf(g.c1, g.c2, g.c3)
    for (var i = 0; i < 3; i++) {
        var cd = cards.get(i)
        var y = 220 + i * 34
        textC(c, "JUIZ " + (i + 1), 480, y, 2, 2, Color(170, 170, 210))
        textC(c, "" + cd.a[g.round], 330, y - 4, 4, 3, Color(255, 255, 255))
        textC(c, "" + cd.b[g.round], 640, y - 4, 4, 3, Color(255, 255, 255))
    }
    var a = g.a
    var b = g.b
    textC(c, "GOLPES", 480, 336, 2, 2, Color(170, 170, 210))
    textC(c, a.landedR + "/" + a.thrownR, 330, 334, 3, 2, Color(255, 255, 255))
    textC(c, b.landedR + "/" + b.thrownR, 640, 334, 3, 2, Color(255, 255, 255))
    textC(c, "PODER", 480, 364, 2, 2, Color(170, 170, 210))
    textC(c, "" + a.powerR, 330, 362, 3, 2, Color(255, 255, 255))
    textC(c, "" + b.powerR, 640, 362, 3, 2, Color(255, 255, 255))
    textC(c, "QUEDAS", 480, 392, 2, 2, Color(170, 170, 210))
    textC(c, "" + a.kdR, 330, 390, 3, 2, Color(255, 255, 255))
    textC(c, "" + b.kdR, 640, 390, 3, 2, Color(255, 255, 255))
    if ((g.frame / 20) % 2 == 0) { textC(c, "ENTER = CONTINUAR", 480, 420, 2, 2, Color(120, 255, 170)) }
}

Int pct(Int a, Int b) {
    if (b <= 0) { return 0 }
    return a * 100 / b
}

drawOver(Canvas c, Game g) {
    dim(c, clampd(toD(g.t) / 90.0, 0.0, 0.5))
    if (g.t < 50) { return }
    panel(c, 170.0, 70.0, 620.0, 400.0, 0.85)
    textGlow(c, g.how, 480, 86, 5, 3, Color(255, 255, 255), Color(255, 60, 60))
    if (g.winner == 0) {
        textGlow(c, "EMPATE", 480, 140, 8, 4, Color(255, 230, 90), Color(255, 140, 40))
    } else {
        var wk = g.a.kind
        if (g.winner == 2) { wk = g.b.kind }
        textC(c, "VENCEDOR", 480, 130, 2, 2, Color(190, 190, 220))
        textGlow(c, fName(wk), 480, 150, 6, 3, Color(255, 255, 255), trunkC(wk))
    }
    if (g.sub != "") { textC(c, g.sub, 480, 200, 2, 2, Color(190, 190, 220)) }
    var y = 226
    if (g.how.indexOf("DECISAO") >= 0 || g.winner == 0) {
        var cards = listOf(g.c1, g.c2, g.c3)
        for (var i = 0; i < 3; i++) {
            var cd = cards.get(i)
            var s = "JUIZ " + (i + 1) + "   " + cardTotal(cd, 1, g.rounds) + " - " + cardTotal(cd, 2, g.rounds)
            textC(c, s, 480, y, 3, 2, Color(255, 255, 255))
            y = y + 26
        }
    }
    var a = g.a
    var b = g.b
    y = y + 10
    text(c, fName(a.kind), 210, y, 2, 2, trunkC(a.kind))
    var nb = fName(b.kind)
    text(c, nb, 750 - textW(nb, 2), y, 2, 2, trunkC(b.kind))
    y = y + 24
    textC(c, "CONECTADOS", 480, y, 2, 2, Color(170, 170, 210))
    textC(c, a.landed + "/" + a.thrown + " " + pct(a.landed, a.thrown) + "%", 290, y - 2, 2, 2, Color(255, 255, 255))
    textC(c, b.landed + "/" + b.thrown + " " + pct(b.landed, b.thrown) + "%", 670, y - 2, 2, 2, Color(255, 255, 255))
    y = y + 24
    textC(c, "GOLPES DE PODER", 480, y, 2, 2, Color(170, 170, 210))
    textC(c, "" + a.power, 290, y - 2, 2, 2, Color(255, 255, 255))
    textC(c, "" + b.power, 670, y - 2, 2, 2, Color(255, 255, 255))
    y = y + 24
    textC(c, "QUEDAS SOFRIDAS", 480, y, 2, 2, Color(170, 170, 210))
    textC(c, "" + a.kdTotal, 290, y - 2, 2, 2, Color(255, 255, 255))
    textC(c, "" + b.kdTotal, 670, y - 2, 2, 2, Color(255, 255, 255))
    if (g.t > 60 && (g.frame / 20) % 2 == 0) { textC(c, "ENTER = NOVA LUTA", 480, 446, 3, 2, Color(120, 255, 170)) }
}

drawPause(Canvas c, Game g) {
    dim(c, 0.6)
    textGlow(c, "PAUSA", 480, 150, 10, 5, Color(255, 255, 255), Color(110, 90, 255))
    textC(c, "P OU ESC = VOLTAR", 480, 260, 3, 2, Color(200, 200, 230))
    textC(c, "N = SOM   M = MUSICA", 480, 290, 3, 2, Color(200, 200, 230))
}

drawTitle(Canvas c, Game g) {
    dim(c, 0.4)
    var t = toD(g.frame)
    var y0 = 70 + toI(sn(t * 0.03) * 4.0)
    textGlow(c, "RINGUE KOF", 480, y0, 14, 6, Color(255, 255, 255), Color(255, 50, 140))
    textGlow(c, "90'S", 480, y0 + 104, 12, 6, Color(120, 235, 255), Color(60, 120, 255))
    panel(c, 176.0, 256.0, 608.0, 26.0, 0.85)
    textC(c, "HOMENAGEM A REALSPORTS BOXING - ATARI 2600 - 1987", 480, 262, 2, 2, Color(220, 220, 245))
    if (!g.loaded) {
        var f = toD(g.mix.loaded) / toD(g.mix.total)
        panel(c, 330.0, 300.0, 300.0, 40.0, 0.7)
        textC(c, "GERANDO SONS EM KOF " + g.mix.loaded + "/" + g.mix.total, 480, 306, 2, 2, Color(200, 200, 255))
        fillRect(c, 350.0, 326.0, 260.0, 6.0, Color(40, 40, 60))
        fillRect(c, 350.0, 326.0, 260.0 * f, 6.0, Color(110, 230, 255))
    } else if ((g.frame / 25) % 2 == 0) {
        textGlow(c, "CLIQUE EM LUTAR! OU APERTE ENTER", 480, 312, 3, 2, Color(255, 255, 255), Color(255, 200, 60))
    }
    textC(c, "POWERED BY KOF - GITHUB.COM/KOFLANG", 480, 512, 2, 2, Color(130, 130, 170))
}

statBar(Canvas c, String label, Int v, Int x, Int y, Color col) {
    text(c, label, x, y, 2, 2, Color(170, 170, 210))
    for (var i = 0; i < 5; i++) {
        var on = i < v
        var cc = Color(40, 40, 60)
        if (on) { cc = col }
        fillQuad(c, x + 90 + i * 24 + 3, y, x + 90 + i * 24 + 22, y, x + 90 + i * 24 + 19, y + 10, x + 90 + i * 24, y + 10, cc)
    }
}

drawCard(Canvas c, Game g, Int k, Fighter pv, Int cx, String who, String keys) {
    panel(c, toD(cx - 210), 60.0, 420.0, 420.0, 0.82)
    textC(c, who, cx, 74, 3, 2, Color(170, 170, 210))
    textGlow(c, fName(k), cx, 98, 4, 3, Color(255, 255, 255), trunkC(k))
    textC(c, fStyle(k), cx, 130, 2, 2, Color(200, 200, 235))
    pv.kind = k
    drawFighter(c, g, pv)
    var labels = listOf("FORCA", "VELOC", "QUEIXO", "FOLEGO", "DEFESA")
    for (var i = 0; i < 5; i++) {
        statBar(c, labels.get(i), stat(k, i), cx - 150, 376 + i * 18, trunkC(k))
    }
    textC(c, keys, cx, 468, 2, 2, Color(140, 140, 180))
}

drawSelect(Canvas c, Game g) {
    dim(c, 0.78)
    textGlow(c, "ESCOLHA OS LUTADORES", 480, 20, 4, 3, Color(255, 255, 255), Color(110, 90, 255))
    var who2 = "CPU"
    if (g.mode == 2) { who2 = "JOGADOR 2" }
    Prev.A.x = 240.0
    Prev.A.z = 30.0
    Prev.A.face = 1
    Prev.B.x = 720.0
    Prev.B.z = 30.0
    Prev.B.face = -1
    Prev.A.stT = Prev.A.stT + 1
    Prev.B.stT = Prev.B.stT + 1
    drawCard(c, g, g.sel1, Prev.A, 250, "JOGADOR 1", "A / D TROCA")
    drawCard(c, g, g.sel2, Prev.B, 710, who2, "SETAS TROCAM")
    textC(c, "VS", 480, 250, 8, 4, Color(255, 200, 60))
    var dTxt = "NORMAL"
    if (g.diff == 1) { dTxt = "FACIL" }
    if (g.diff == 3) { dTxt = "CAMPEAO" }
    var modeTxt = "1 JOGADOR"
    if (g.mode == 2) { modeTxt = "2 JOGADORES" }
    var snd = "SOM ON"
    if (!g.mix.on) { snd = "SOM OFF" }
    textC(c, modeTxt + " - " + g.rounds + " ROUNDS - CPU " + dTxt + " - " + snd, 480, 494, 2, 2, Color(120, 255, 170))
    if ((g.frame / 25) % 2 == 0) { textC(c, "ENTER OU LUTAR! PARA COMECAR", 480, 516, 3, 2, Color(255, 255, 255)) }
}

render(Canvas c, Game g) {
    drawWorld(c, g)
    if (g.state == K.TITLE) {
        drawTitle(c, g)
        return
    }
    if (g.state == K.SELECT) {
        drawSelect(c, g)
        return
    }
    drawHud(c, g)
    if (g.state == K.INTRO) { drawIntro(c, g) }
    if (g.state == K.DOWN) { drawDown(c, g) }
    if (g.state == K.REND) { drawRoundEnd(c, g) }
    if (g.state == K.OVER) { drawOver(c, g) }
    if (g.state == K.PAUSE) { drawPause(c, g) }
    if (g.flashScr > 0) {
        alpha(c, toD(g.flashScr) / 10.0)
        fillRect(c, 0.0, 0.0, 960.0, 540.0, Color(255, 255, 255))
        alpha(c, 1.0)
    }
    // vinheta
    alpha(c, 0.25)
    fillRect(c, 0.0, 0.0, 960.0, 8.0, Color(0, 0, 0))
    fillRect(c, 0.0, 532.0, 960.0, 8.0, Color(0, 0, 0))
    alpha(c, 1.0)
}

// ---------------------------------------------------------------- main
main() {
    buildTrig()
    buildPunchTable()
    var g = Game()
    g.a.kind = g.sel1
    g.b.kind = g.sel2
    g.b.side = 2
    g.b.x = 630.0
    g.b.face = -1
    var c = Canvas(K.W, K.H)
    var w = Window("Ringue KOF 90's")
    w.title = "Ringue KOF 90's - Powered by Kof"

    // canais de audio (5 efeitos + trilha + ambiente); fonte inicial muda
    var mute = renderSnd(newSnd(0.02, 0.0), g.r)
    var c0 = Audio(mute)
    var c1 = Audio(mute)
    var c2 = Audio(mute)
    var c3 = Audio(mute)
    var c4 = Audio(mute)
    var mus = Audio(mute)
    var amb = Audio(mute)

    var bGo = Button(">> LUTAR! (ativa o teclado) <<", () -> { confirm(g) })
    var bP1a = Button("< P1", () -> { cycleSel(g, 1, -1) })
    var bP1b = Button("P1 >", () -> { cycleSel(g, 1, 1) })
    var bP2a = Button("< P2/CPU", () -> { cycleSel(g, 2, -1) })
    var bP2b = Button("P2/CPU >", () -> { cycleSel(g, 2, 1) })
    var bMode = Button("1P / 2P", () -> {
        if (g.state == K.SELECT) {
            g.mode = 3 - g.mode
            sfx(g, K.S_UI)
        }
    })
    var bRounds = Button("Rounds 3/5", () -> {
        if (g.state == K.SELECT) {
            if (g.rounds == 3) { g.rounds = 5 } else { g.rounds = 3 }
            sfx(g, K.S_UI)
        }
    })
    var bDiff = Button("Dificuldade", () -> {
        if (g.state == K.SELECT) {
            g.diff = g.diff % 3 + 1
            sfx(g, K.S_UI)
        }
    })
    var bSnd = Button("Som (N)", () -> { g.mix.on = !g.mix.on })
    var bMus = Button("Musica (M)", () -> { g.mix.music = !g.mix.music })
    var bPause = Button("Pausa (P)", () -> { togglePause(g) })
    var bMenu = Button("Menu", () -> {
        g.state = K.SELECT
        g.t = 0
        g.mix.playCrowd = false
        g.mix.playMusic = true
    })
    var row1 = Row(listOf(bGo, bP1a, bP1b, bP2a, bP2b, bMode, bRounds, bDiff, bSnd, bMus, bPause, bMenu))

    // controle na tela (mouse / toque) para o jogador 1
    var tL = Button("<", () -> {})
    var tU = Button("^", () -> {})
    var tD = Button("v", () -> {})
    var tR = Button(">", () -> {})
    var tJ = Button("JAB", () -> { press(g, g.a, K.JAB, true) })
    var tK = Button("DIRETO", () -> { press(g, g.a, K.CROSS, true) })
    var tH = Button("GANCHO", () -> { press(g, g.a, K.HOOK, true) })
    var tI = Button("UPPER", () -> { press(g, g.a, K.UPPER, true) })
    var tB = Button("CORPO", () -> { press(g, g.a, K.BODY, true) })
    var tG = Button("GUARDA", () -> {})
    var tS = Button("ESQUIVA", () -> { g.a.qSlip = true })
    var tE = Button("ESPECIAL", () -> {})
    tL.on("pointerdown", (e: Event) -> { g.a.inL = true })
    tL.on("pointerup", (e: Event) -> { g.a.inL = false })
    tL.on("pointerleave", (e: Event) -> { g.a.inL = false })
    tR.on("pointerdown", (e: Event) -> { g.a.inR = true })
    tR.on("pointerup", (e: Event) -> { g.a.inR = false })
    tR.on("pointerleave", (e: Event) -> { g.a.inR = false })
    tU.on("pointerdown", (e: Event) -> { g.a.inU = true })
    tU.on("pointerup", (e: Event) -> { g.a.inU = false })
    tU.on("pointerleave", (e: Event) -> { g.a.inU = false })
    tD.on("pointerdown", (e: Event) -> { g.a.inD = true })
    tD.on("pointerup", (e: Event) -> { g.a.inD = false })
    tD.on("pointerleave", (e: Event) -> { g.a.inD = false })
    tG.on("pointerdown", (e: Event) -> { g.a.inG = true })
    tG.on("pointerup", (e: Event) -> { g.a.inG = false })
    tG.on("pointerleave", (e: Event) -> { g.a.inG = false })
    tE.on("pointerdown", (e: Event) -> { g.a.inMod = true })
    tE.on("pointerup", (e: Event) -> { g.a.inMod = false })
    tE.on("pointerleave", (e: Event) -> { g.a.inMod = false })
    var row2 = Row(listOf(tL, tU, tD, tR, tJ, tK, tH, tI, tB, tG, tS, tE))

    var hint = Label("Clique em LUTAR! para ativar o teclado.  P1: WASD anda, J jab, K direto, L gancho, I uppercut, U corpo, ESPACO guarda (segurar), Q esquiva, R + soco = especial.  P2: setas, 1-5 socos, 0 guarda, . esquiva, 6 especial.  Enter, P pausa, N som, M musica.")

    var root = Column(listOf(c, row1, row2, hint))
    root.on("keydown", (e: Event) -> { onKey(g, e.key(), true) })
    root.on("keyup", (e: Event) -> { onKey(g, e.key(), false) })
    w.bind(root)

    // 60 quadros por segundo
    time.interval(16, () -> {
        tick(g)
        render(c, g)
        drain(g, c0, c1, c2, c3, c4, mus, amb)
    })
    println("Ringue KOF 90's pronto. Powered by Kof.")
    w.show()
}
